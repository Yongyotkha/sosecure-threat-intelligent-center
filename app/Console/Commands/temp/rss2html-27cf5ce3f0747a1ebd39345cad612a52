		<title>GoDaddy Employees Used in Attacks on Multiple Cryptocurrency Services</title>
		<link>https://krebsonsecurity.com/2020/11/godaddy-employees-used-in-attacks-on-multiple-cryptocurrency-services/</link>
					<comments>https://krebsonsecurity.com/2020/11/godaddy-employees-used-in-attacks-on-multiple-cryptocurrency-services/#comments</comments>
		
		<dc:creator><![CDATA[BrianKrebs]]></dc:creator>
		<pubDate>Sat, 21 Nov 2020 18:15:49 +0000</pubDate>
