		<title>SolarWinds Hack Could Affect 18K Customers</title>
		<link>https://krebsonsecurity.com/2020/12/solarwinds-hack-could-affect-18k-customers/</link>
					<comments>https://krebsonsecurity.com/2020/12/solarwinds-hack-could-affect-18k-customers/#comments</comments>
		
		<dc:creator><![CDATA[BrianKrebs]]></dc:creator>
		<pubDate>Tue, 15 Dec 2020 17:41:37 +0000</pubDate>
