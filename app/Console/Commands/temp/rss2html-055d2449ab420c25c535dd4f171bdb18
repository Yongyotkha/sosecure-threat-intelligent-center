		<title>Can You Decode Your Teen’s Texting Language?</title>
		<link>https://www.mcafee.com/blogs/consumer/family-safety/can-you-decode-your-teens-texting-language/</link>
		
		<dc:creator><![CDATA[Toni Birdsong]]></dc:creator>
		<pubDate>Wed, 09 Sep 2020 17:25:58 +0000</pubDate>
				<category><![CDATA[Family Safety]]></category>
		<category><![CDATA[cyberbullying]]></category>
		<category><![CDATA[facebook]]></category>
		<category><![CDATA[social networking]]></category>
