		<title>What is GPS spoofing?</title>
		<link>https://www.mcafee.com/blogs/consumer/what-is-gps-spoofing/</link>
		
		<dc:creator><![CDATA[McAfee]]></dc:creator>
		<pubDate>Tue, 25 Aug 2020 21:32:51 +0000</pubDate>
				<category><![CDATA[Consumer]]></category>
