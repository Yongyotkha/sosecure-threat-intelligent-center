		<title>How CASB and EDR Protect Federal Agencies in the Age of Work from Home</title>
		<link>https://www.mcafee.com/blogs/enterprise/cloud-security/how-casb-and-edr-protect-federal-agencies-in-the-age-of-work-from-home/</link>
		
		<dc:creator><![CDATA[John Amorosi]]></dc:creator>
		<pubDate>Tue, 10 Nov 2020 16:00:22 +0000</pubDate>
				<category><![CDATA[Cloud Security]]></category>
