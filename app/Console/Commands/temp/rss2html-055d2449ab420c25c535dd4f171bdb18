		<title>With No Power Comes More Responsibility</title>
		<link>https://www.mcafee.com/blogs/enterprise/cloud-security/with-no-power-comes-more-responsibility/</link>
		
		<dc:creator><![CDATA[Rich Vorwaller]]></dc:creator>
		<pubDate>Thu, 29 Oct 2020 17:05:28 +0000</pubDate>
				<category><![CDATA[Cloud Security]]></category>
