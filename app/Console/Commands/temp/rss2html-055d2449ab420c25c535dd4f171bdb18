		<link>https://www.mcafee.com/blogs/enterprise/cloud-security/securing-containers-with-nist-800-190-and-mvision-cnapp/</link>
		
		<dc:creator><![CDATA[Sunny Suneja]]></dc:creator>
		<pubDate>Wed, 09 Dec 2020 16:52:22 +0000</pubDate>
				<category><![CDATA[Cloud Security]]></category>
		<category><![CDATA[public sector]]></category>
